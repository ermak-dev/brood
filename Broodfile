apiVersion: brood.dev/v1alpha1
name: brood
project:
  description: Agent pool on Agent Substrate
  git_credential: brood-gitlab
defaultTarget: development
pinsFile: brood/dev/pins.json
sources:
  project:
    type: project
    destination: brood
    gitMetadata: true
  substrate:
    type: git
    repository: https://github.com/ermak-dev/substrate.git
    revisionPin: SUBSTRATE_COMMIT
    destination: substrate
    gitMetadata: true
environments:
  workbench:
    sources: [project, substrate]
    build:
      dockerfile: brood/brood/dev/workbench/Dockerfile
      platform: linux/amd64
      argsFromPins: [PYTHON_IMAGE, GO_VERSION, GO_SHA256]
templates:
  development:
    environment: workbench
    network: development
    actor:
      workerSelector:
        matchLabels:
          brood.dev/purpose: development
          brood.dev/sandbox: lxc
          ate.dev/lxc-nesting: enabled
      resources:
        limits: {cpuMillicores: '4000', memoryBytes: '8589934592'}
      snapshotConfig:
        preferredFidelity: SNAPSHOT_FIDELITY_VOLUMES
        goldenSnapshotConfig: {mode: GOLDEN_SNAPSHOT_MODE_DISABLED}
      containers:
        - name: main
          command: [/usr/bin/tini, '--', /opt/seeds/brood/bin/brood, workbench, start]
          args: ['--', bash, .ci/workbench.sh]
          env:
            - {name: HOME, value: /workspace/home}
            - {name: XDG_DATA_HOME, value: /workspace/data}
            - {name: SUBSTRATE_SOURCE, value: /workspace/substrate}
            - {name: TMPDIR, value: /workspace/tmp}
            - {name: DOCKER_HOST, value: 'unix:///var/run/docker.sock'}
            - {name: GOMAXPROCS, value: '4'}
            - {name: GOFLAGS, value: '-p=2'}
            - {name: PIP_FIND_LINKS, value: /opt/wheels}
            - {name: PIP_NO_INDEX, value: '1'}
          volumeMounts: [{name: workspace, mountPath: /workspace}]
          securityContext:
            capabilities:
              add: [CHOWN, DAC_OVERRIDE, FOWNER, FSETID, KILL, SETGID, SETUID,
                    SETPCAP, NET_BIND_SERVICE, NET_ADMIN, NET_RAW,
                    SYS_CHROOT, SYS_PTRACE, SYS_ADMIN, SYS_RESOURCE, MKNOD,
                    AUDIT_WRITE, SETFCAP, SYSLOG]
      volumes: [{name: workspace, durableDir: {}}]
  coding:
    environment: workbench
    network: coding
    actor:
      workerSelector:
        matchLabels:
          brood.dev/purpose: development
          brood.dev/sandbox: lxc
          ate.dev/lxc-nesting: enabled
      resources:
        limits: {cpuMillicores: '4000', memoryBytes: '8589934592'}
      snapshotConfig:
        preferredFidelity: SNAPSHOT_FIDELITY_VOLUMES
        goldenSnapshotConfig: {mode: GOLDEN_SNAPSHOT_MODE_DISABLED}
      containers:
        - name: main
          command: [/usr/bin/tini, '--', /opt/seeds/brood/bin/brood, workbench, start]
          args: ['--results-port', '8081', '--', bash, '-c',
                 'claude --version && exec ttyd --writable --check-origin --port 80 tmux new-session -A -s claude claude']
          env:
            - {name: HOME, value: /workspace/home}
            - {name: XDG_DATA_HOME, value: /workspace/data}
            - {name: SUBSTRATE_SOURCE, value: /workspace/substrate}
            - {name: TMPDIR, value: /workspace/tmp}
            - {name: DOCKER_HOST, value: 'unix:///var/run/docker.sock'}
            - {name: GOMAXPROCS, value: '4'}
            - {name: GOFLAGS, value: '-p=2'}
            - {name: PIP_FIND_LINKS, value: /opt/wheels}
            - {name: PIP_NO_INDEX, value: '1'}
            - {name: BROOD_WORKBENCH_PROFILE, value: claude-code}
            - {name: DISABLE_AUTOUPDATER, value: '1'}
            - {name: DISABLE_UPDATES, value: '1'}
            - {name: CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC, value: '1'}
            - {name: CLAUDE_CODE_DISABLE_ARTIFACT, value: '1'}
            - {name: ENABLE_CLAUDEAI_MCP_SERVERS, value: 'false'}
          volumeMounts: [{name: workspace, mountPath: /workspace}]
          securityContext:
            capabilities:
              add: [CHOWN, DAC_OVERRIDE, FOWNER, FSETID, KILL, SETGID, SETUID,
                    SETPCAP, NET_BIND_SERVICE, NET_ADMIN, NET_RAW,
                    SYS_CHROOT, SYS_PTRACE, SYS_ADMIN, SYS_RESOURCE, MKNOD,
                    AUDIT_WRITE, SETFCAP, SYSLOG]
      volumes: [{name: workspace, durableDir: {}}]
networks:
  development:
    tls:
      hosts: [pypi.org, files.pythonhosted.org, registry.npmjs.org, index.crates.io, static.crates.io,
              gcr.io, github.com, api.github.com, raw.githubusercontent.com, codeload.github.com,
              release-assets.githubusercontent.com, objects.githubusercontent.com,
              pkg-containers.githubusercontent.com, ghcr.io, proxy.golang.org, sum.golang.org,
              go.dev, dl.google.com, storage.googleapis.com, dl.k8s.io, cdn.dl.k8s.io,
              registry.k8s.io, auth.docker.io, us-docker.pkg.dev, us-central1-docker.pkg.dev,
              us-west1-docker.pkg.dev, us-west2-docker.pkg.dev, europe-west1-docker.pkg.dev,
              europe-west2-docker.pkg.dev, asia-east1-docker.pkg.dev, registry-1.docker.io,
              production.cloudflare.docker.com, production.cloudfront.docker.com, cgr.dev,
              docker-images-prod.6aa30f8b08e16409b46e0173d6de2f56.r2.cloudflarestorage.com]
      ports: [443]
    http:
      hosts: [deb.debian.org, security.debian.org]
      ports: [80]
  coding:
    tls:
      hosts: [pypi.org, files.pythonhosted.org, registry.npmjs.org, index.crates.io, static.crates.io,
              gcr.io, github.com, api.github.com, raw.githubusercontent.com, codeload.github.com,
              release-assets.githubusercontent.com, objects.githubusercontent.com,
              pkg-containers.githubusercontent.com, ghcr.io, proxy.golang.org, sum.golang.org,
              go.dev, dl.google.com, storage.googleapis.com, dl.k8s.io, cdn.dl.k8s.io,
              registry.k8s.io, auth.docker.io, us-docker.pkg.dev, us-central1-docker.pkg.dev,
              us-west1-docker.pkg.dev, us-west2-docker.pkg.dev, europe-west1-docker.pkg.dev,
              europe-west2-docker.pkg.dev, asia-east1-docker.pkg.dev, registry-1.docker.io,
              production.cloudflare.docker.com, production.cloudfront.docker.com, cgr.dev,
              docker-images-prod.6aa30f8b08e16409b46e0173d6de2f56.r2.cloudflarestorage.com,
              api.anthropic.com, claude.ai, claude.com, platform.claude.com,
              sso.claude.com, downloads.claude.ai, code.claude.com]
      ports: [443]
    http:
      hosts: [deb.debian.org, security.debian.org]
      ports: [80]
targets:
  development: {template: development}
  coding: {template: coding}
workflows:
  develop:
    start: implement
    exit: done
    nodes:
      implement:
        type: actor
        role: build
        actionClasses: [work]
        prompt: >-
          Implement the scoped feature following CLAUDE.md. Investigate existing
          code, check duplicates, and establish the issue and branch before code;
          keep one change per layer. Write a failing test before changing pure
          functions, then make the smallest implementation and report red/green
          evidence. Run applicable brood dev test and ruff check; for Go changes
          run go build ./... and go test ./... from go/. For panel changes run
          brood dev web test and check affected pages in a browser against the
          Go API. Report actual commands, results, the exact diff and blockers;
          fail if required checks are unavailable or fail. When architecture or
          requirements need an operator decision, use the existing actor
          ask_operator request and wait for the answer before dependent work;
          do not substitute a proposal for approval. Do not fabricate approval,
          test results, permissions or effects, and do not deploy.
      review:
        type: actor
        role: review
        actionClasses: [review]
        prompt: >-
          Perform an independent review in a fresh session on a different actor
          from the implementer, without relying on the implementer's conclusions.
          Inspect the exact workspace diff and artifact proposed for landing,
          issue scope, CLAUDE.md compliance, tests and recorded check results.
          Report defects and evidence; fail if findings remain unresolved,
          required checks are missing or independence cannot be established.
          Review only that exact artifact; later changes require fresh review.
          Do not fabricate approval, tests, permissions or effects.
      land:
        type: actor
        role: build
        actionClasses: [landing]
        prompt: >-
          Land only the exact reviewed artifact with no unresolved findings and
          all required checks passing. Verify current external permissions for
          the actual repository and merge request; a prompt or policy decision
          does not grant those permissions. Follow CLAUDE.md: rebase on main,
          one push, and handle review comments in a separate push without rebase;
          changes to the reviewed artifact require fresh independent review and
          checks before merge. Use the actual merge request and confirm CI and
          the merged commit on main. Return proof with the merge request URL,
          check results and merged commit identity; fail if blocked or proof is
          unavailable. Do not fabricate approval, merge or other effects. Do not
          deploy or perform unrelated external actions.
      done: {type: exit}
    edges:
      - {from: implement, to: review, condition: 'outcome=success'}
      - {from: review, to: land, condition: 'outcome=success'}
      - {from: land, to: done, condition: 'outcome=success'}
    goalGates: [done]
  fix:
    start: implement
    exit: done
    nodes:
      implement:
        type: actor
        role: build
        actionClasses: [work]
        prompt: >-
          Investigate and reproduce the scoped bug following CLAUDE.md. Check
          duplicates, establish the issue and branch before code, record expected
          and actual behavior, and confirm the root cause. Write a failing test
          as a regression test before the minimal fix; keep one change per layer
          and never weaken tests to pass. Report red/green evidence. Run applicable
          brood dev test and ruff check; for Go changes run go build ./... and
          go test ./... from go/. For panel changes run brood dev web test and
          check affected pages in a browser against the Go API. Report actual
          commands, results, the exact diff and blockers; fail if reproduction
          or required checks are unavailable or fail. When architecture or
          requirements need an operator decision, use the existing actor
          ask_operator request and wait for the answer before dependent work;
          do not substitute a proposal for approval. Do not fabricate approval,
          reproduction, test results, permissions or effects, and do not deploy.
      review:
        type: actor
        role: review
        actionClasses: [review]
        prompt: >-
          Perform an independent review in a fresh session on a different actor
          from the implementer, without relying on the implementer's conclusions.
          Inspect the exact workspace diff and artifact proposed for landing,
          the reproduction, root cause, regression tests and CLAUDE.md compliance.
          Report defects and evidence; fail if findings remain unresolved,
          required checks are missing or independence cannot be established.
          Review only that exact artifact; later changes require fresh review.
          Do not fabricate approval, tests, permissions or effects.
      land:
        type: actor
        role: build
        actionClasses: [landing]
        prompt: >-
          Land only the exact reviewed artifact with no unresolved findings and
          all required checks passing. Verify current external permissions for
          the actual repository and merge request; a prompt or policy decision
          does not grant those permissions. Follow CLAUDE.md: rebase on main,
          one push, and handle review comments in a separate push without rebase;
          changes to the reviewed artifact require fresh independent review and
          checks before merge. Use the actual merge request and confirm CI and
          the merged commit on main. Return proof with the merge request URL,
          check results and merged commit identity; fail if blocked or proof is
          unavailable. Do not fabricate approval, merge or other effects. Do not
          deploy or perform unrelated external actions.
      done: {type: exit}
    edges:
      - {from: implement, to: review, condition: 'outcome=success'}
      - {from: review, to: land, condition: 'outcome=success'}
      - {from: land, to: done, condition: 'outcome=success'}
    goalGates: [done]
  docs:
    start: implement
    exit: done
    nodes:
      implement:
        type: actor
        role: build
        actionClasses: [work]
        prompt: >-
          Make the scoped documentation-only change following CLAUDE.md. Check
          duplicates and establish the issue and branch before edits; keep one
          change per layer. Verify claims against current code, check examples
          and links, and run applicable documentation checks. Do not change runtime
          behavior or expand into an implementation task. If executable examples
          or pure functions need correction, establish a failing test before the
          correction and resolve the issue scope first. Run applicable brood dev test
          and ruff check; for Go changes run go build ./... and go test ./... from
          go/. For panel changes run brood dev web test and check affected pages
          in a browser against the Go API. Report actual commands, results, the
          exact diff and blockers; fail if required verification is unavailable
          or fails. When architecture or requirements need an operator decision,
          use the existing actor ask_operator request and wait for the answer
          before dependent work; do not substitute a proposal for approval.
          Do not fabricate approval, verification, permissions or effects,
          and do not deploy.
      review:
        type: actor
        role: review
        actionClasses: [review]
        prompt: >-
          Perform an independent review in a fresh session on a different actor
          from the implementer, without relying on the implementer's conclusions.
          Inspect the exact workspace diff and artifact proposed for landing,
          documentation accuracy against code, examples, links, applicable tests
          and CLAUDE.md compliance. Report defects and evidence; fail if findings
          remain unresolved, required checks are missing or independence cannot
          be established. Review only that exact artifact; later changes require
          fresh review. Do not fabricate approval, tests, permissions or effects.
      land:
        type: actor
        role: build
        actionClasses: [landing]
        prompt: >-
          Land only the exact reviewed artifact with no unresolved findings and
          all required checks passing. Verify current external permissions for
          the actual repository and merge request; a prompt or policy decision
          does not grant those permissions. Follow CLAUDE.md: rebase on main,
          one push, and handle review comments in a separate push without rebase;
          changes to the reviewed artifact require fresh independent review and
          checks before merge. Use the actual merge request and confirm CI and
          the merged commit on main. Return proof with the merge request URL,
          check results and merged commit identity; fail if blocked or proof is
          unavailable. Do not fabricate approval, merge or other effects. Do not
          deploy or perform unrelated external actions.
      done: {type: exit}
    edges:
      - {from: implement, to: review, condition: 'outcome=success'}
      - {from: review, to: land, condition: 'outcome=success'}
      - {from: land, to: done, condition: 'outcome=success'}
    goalGates: [done]
