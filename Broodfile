apiVersion: brood.dev/v1alpha1
name: brood
project:
  description: Agent pool on Agent Substrate
  git_credential: brood-gitlab
defaultTarget: development
pinsFile: brood/dev/pins.json
sources:
  project:
    type: project
    destination: brood
    gitMetadata: true
  substrate:
    type: git
    repository: https://github.com/ermak-dev/substrate.git
    revisionPin: SUBSTRATE_COMMIT
    destination: substrate
    gitMetadata: true
environments:
  workbench:
    sources: [project, substrate]
    build:
      dockerfile: brood/brood/dev/workbench/Dockerfile
      platform: linux/amd64
      argsFromPins: [PYTHON_IMAGE, GO_VERSION, GO_SHA256]
templates:
  development:
    environment: workbench
    network: development
    actor:
      workerSelector:
        matchLabels:
          brood.dev/purpose: development
          brood.dev/sandbox: lxc
          ate.dev/lxc-nesting: enabled
      resources:
        limits: {cpuMillicores: '4000', memoryBytes: '8589934592'}
      snapshotConfig:
        preferredFidelity: SNAPSHOT_FIDELITY_VOLUMES
        goldenSnapshotConfig: {mode: GOLDEN_SNAPSHOT_MODE_DISABLED}
      containers:
        - name: main
          command: [/usr/bin/tini, '--', /opt/seeds/brood/bin/brood, workbench, start]
          args: ['--', bash, .ci/workbench.sh]
          env:
            - {name: HOME, value: /workspace/home}
            - {name: XDG_DATA_HOME, value: /workspace/data}
            - {name: SUBSTRATE_SOURCE, value: /workspace/substrate}
            - {name: TMPDIR, value: /workspace/tmp}
            - {name: DOCKER_HOST, value: 'unix:///var/run/docker.sock'}
            - {name: GOMAXPROCS, value: '4'}
            - {name: GOFLAGS, value: '-p=2'}
            - {name: PIP_FIND_LINKS, value: /opt/wheels}
            - {name: PIP_NO_INDEX, value: '1'}
          volumeMounts: [{name: workspace, mountPath: /workspace}]
          securityContext:
            capabilities:
              add: [CHOWN, DAC_OVERRIDE, FOWNER, FSETID, KILL, SETGID, SETUID,
                    SETPCAP, NET_BIND_SERVICE, NET_ADMIN, NET_RAW,
                    SYS_CHROOT, SYS_PTRACE, SYS_ADMIN, SYS_RESOURCE, MKNOD,
                    AUDIT_WRITE, SETFCAP, SYSLOG]
      volumes: [{name: workspace, durableDir: {}}]
  coding:
    environment: workbench
    network: coding
    actor:
      workerSelector:
        matchLabels:
          brood.dev/purpose: development
          brood.dev/sandbox: lxc
          ate.dev/lxc-nesting: enabled
      resources:
        limits: {cpuMillicores: '4000', memoryBytes: '8589934592'}
      snapshotConfig:
        preferredFidelity: SNAPSHOT_FIDELITY_VOLUMES
        goldenSnapshotConfig: {mode: GOLDEN_SNAPSHOT_MODE_DISABLED}
      containers:
        - name: main
          command: [/usr/bin/tini, '--', /opt/seeds/brood/bin/brood, workbench, start]
          args: ['--results-port', '8081', '--', bash, '-c',
                 'claude --version && exec ttyd --writable --check-origin --port 80 tmux new-session -A -s claude claude']
          env:
            - {name: HOME, value: /workspace/home}
            - {name: XDG_DATA_HOME, value: /workspace/data}
            - {name: SUBSTRATE_SOURCE, value: /workspace/substrate}
            - {name: TMPDIR, value: /workspace/tmp}
            - {name: DOCKER_HOST, value: 'unix:///var/run/docker.sock'}
            - {name: GOMAXPROCS, value: '4'}
            - {name: GOFLAGS, value: '-p=2'}
            - {name: PIP_FIND_LINKS, value: /opt/wheels}
            - {name: PIP_NO_INDEX, value: '1'}
            - {name: BROOD_WORKBENCH_PROFILE, value: claude-code}
            - {name: DISABLE_AUTOUPDATER, value: '1'}
            - {name: DISABLE_UPDATES, value: '1'}
            - {name: CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC, value: '1'}
            - {name: CLAUDE_CODE_DISABLE_ARTIFACT, value: '1'}
            - {name: ENABLE_CLAUDEAI_MCP_SERVERS, value: 'false'}
          volumeMounts: [{name: workspace, mountPath: /workspace}]
          securityContext:
            capabilities:
              add: [CHOWN, DAC_OVERRIDE, FOWNER, FSETID, KILL, SETGID, SETUID,
                    SETPCAP, NET_BIND_SERVICE, NET_ADMIN, NET_RAW,
                    SYS_CHROOT, SYS_PTRACE, SYS_ADMIN, SYS_RESOURCE, MKNOD,
                    AUDIT_WRITE, SETFCAP, SYSLOG]
      volumes: [{name: workspace, durableDir: {}}]
networks:
  development:
    tls:
      hosts: [pypi.org, files.pythonhosted.org, registry.npmjs.org, index.crates.io, static.crates.io,
              gcr.io, github.com, api.github.com, raw.githubusercontent.com, codeload.github.com,
              release-assets.githubusercontent.com, objects.githubusercontent.com,
              pkg-containers.githubusercontent.com, ghcr.io, proxy.golang.org, sum.golang.org,
              go.dev, dl.google.com, storage.googleapis.com, dl.k8s.io, cdn.dl.k8s.io,
              registry.k8s.io, auth.docker.io, us-docker.pkg.dev, us-central1-docker.pkg.dev,
              us-west1-docker.pkg.dev, us-west2-docker.pkg.dev, europe-west1-docker.pkg.dev,
              europe-west2-docker.pkg.dev, asia-east1-docker.pkg.dev, registry-1.docker.io,
              production.cloudflare.docker.com, production.cloudfront.docker.com, cgr.dev,
              docker-images-prod.6aa30f8b08e16409b46e0173d6de2f56.r2.cloudflarestorage.com]
      ports: [443]
    http:
      hosts: [deb.debian.org, security.debian.org]
      ports: [80]
  coding:
    tls:
      hosts: [pypi.org, files.pythonhosted.org, registry.npmjs.org, index.crates.io, static.crates.io,
              gcr.io, github.com, api.github.com, raw.githubusercontent.com, codeload.github.com,
              release-assets.githubusercontent.com, objects.githubusercontent.com,
              pkg-containers.githubusercontent.com, ghcr.io, proxy.golang.org, sum.golang.org,
              go.dev, dl.google.com, storage.googleapis.com, dl.k8s.io, cdn.dl.k8s.io,
              registry.k8s.io, auth.docker.io, us-docker.pkg.dev, us-central1-docker.pkg.dev,
              us-west1-docker.pkg.dev, us-west2-docker.pkg.dev, europe-west1-docker.pkg.dev,
              europe-west2-docker.pkg.dev, asia-east1-docker.pkg.dev, registry-1.docker.io,
              production.cloudflare.docker.com, production.cloudfront.docker.com, cgr.dev,
              docker-images-prod.6aa30f8b08e16409b46e0173d6de2f56.r2.cloudflarestorage.com,
              api.anthropic.com, claude.ai, claude.com, platform.claude.com,
              sso.claude.com, downloads.claude.ai, code.claude.com]
      ports: [443]
    http:
      hosts: [deb.debian.org, security.debian.org]
      ports: [80]
targets:
  development: {template: development}
  coding: {template: coding}
workflows:
  swarm-development:
    start: triage
    exit: done
    nodes:
      triage:
        type: actor
        role: review
        prompt: >-
          Investigate the issue and existing code. Check for duplicates, establish
          evidence and scope, and report the plan and unknowns. Follow CLAUDE.md.
          If an architectural decision is needed, stop and report that the
          architecture workflow must be selected externally. Do not claim success
          if blocked or unable to establish the requirements.
      implement:
        type: actor
        role: build
        prompt: >-
          Implement the scoped issue following CLAUDE.md, including the issue and
          branch process, one change per layer, and test-first development where
          required. Report the diff, evidence, and blockers; do not claim success
          on failure or substitute instructions for authorization.
      review:
        type: actor
        role: review
        prompt: >-
          Independently review the implementation in a fresh session, without
          relying on the implementer's conclusions. Examine the diff for defects,
          regressions, and project rule violations. Report findings and block
          progress if unresolved or independence cannot be established.
      test:
        type: actor
        role: build
        prompt: >-
          Run the applicable checks from CLAUDE.md, including brood dev test and
          ruff check, and Go build and tests for Go changes. For panel changes run
          the prescribed web tests and browser checks. Report exact results and
          fail on errors, unavailable checks, or unresolved review findings.
      integrate:
        type: actor
        role: build
        prompt: >-
          Follow the CLAUDE.md landing process for the approved change: review the
          diff, rebase on main and use one push, with review comments handled in
          a separate push without rebase. Confirm required checks and permissions;
          report blockers and never claim integration without evidence. Do not
          deploy or perform an action without the required authorization.
      done: {type: exit}
    edges:
      - {from: triage, to: implement, condition: 'outcome=success'}
      - {from: implement, to: review, condition: 'outcome=success'}
      - {from: review, to: test, condition: 'outcome=success'}
      - {from: test, to: integrate, condition: 'outcome=success'}
      - {from: integrate, to: done, condition: 'outcome=success'}
    goalGates: [done]
  swarm-architecture:
    start: triage
    exit: done
    nodes:
      triage:
        type: actor
        role: review
        prompt: >-
          Investigate the issue, check for duplicates and document evidence,
          scope, and why an architectural decision is needed. Follow CLAUDE.md;
          stop and report blockers rather than claiming success.
      architecture:
        type: actor
        role: review
        prompt: >-
          Prepare the architectural decision for a human: describe the problem,
          alternatives, tradeoffs, risks, recommendation and open questions.
          Do not implement or treat the proposal as approved.
      decision:
        type: human
        question: Approve the proposed architectural decision for implementation?
        options:
          - {label: Approve, outcome: success}
          - {label: Reject, outcome: fail}
      implement:
        type: actor
        role: build
        prompt: >-
          Implement only the approved architecture and scoped issue, following
          CLAUDE.md, the issue and branch process, layer boundaries and required
          test-first development. Report evidence and blockers; stop if the
          approval or requirements cannot be established.
      review:
        type: actor
        role: review
        prompt: >-
          Independently review the implementation in a fresh session, without
          relying on the implementer's conclusions. Examine the diff against the
          approved architecture and CLAUDE.md. Report findings and block progress
          if unresolved or independence cannot be established.
      test:
        type: actor
        role: build
        prompt: >-
          Run the applicable checks from CLAUDE.md, including brood dev test and
          ruff check, and Go build and tests for Go changes. For panel changes run
          the prescribed web tests and browser checks. Report exact results and
          fail on errors, unavailable checks, or unresolved review findings.
      integrate:
        type: actor
        role: build
        prompt: >-
          Follow the CLAUDE.md landing process for the approved change: review the
          diff, rebase on main and use one push, with review comments handled in
          a separate push without rebase. Confirm required checks and permissions;
          report blockers and never claim integration without evidence. Do not
          deploy or perform an action without the required authorization.
      done: {type: exit}
    edges:
      - {from: triage, to: architecture, condition: 'outcome=success'}
      - {from: architecture, to: decision, condition: 'outcome=success'}
      - {from: decision, to: implement, condition: 'outcome=success'}
      - {from: decision, to: done, condition: 'outcome=fail'}
      - {from: implement, to: review, condition: 'outcome=success'}
      - {from: review, to: test, condition: 'outcome=success'}
      - {from: test, to: integrate, condition: 'outcome=success'}
      - {from: integrate, to: done, condition: 'outcome=success'}
    goalGates: [done]
