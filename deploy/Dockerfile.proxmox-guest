ARG PYTHON_IMAGE
ARG DRIFTTY_NODE_IMAGE
FROM ${DRIFTTY_NODE_IMAGE} AS driftty
ARG DRIFTTY_COMMIT
ARG DRIFTTY_SHA256
ARG DRIFTTY_INDEX_SHA256
ARG DRIFTTY_DIRECT_INDEX_SHA256
# Проверенный архив извлекается в отдельный пустой каталог; gateway не собираем.
ADD --checksum=sha256:${DRIFTTY_SHA256} https://codeload.github.com/mdp/driftty/tar.gz/${DRIFTTY_COMMIT} /download/source.tar.gz
RUN mkdir /source /home/node/build \
    && tar -xzf /download/source.tar.gz -C /source --strip-components=1 \
    && cp /source/package.json /source/package-lock.json /home/node/build/ \
    && chown -R node:node /home/node/build
USER node
WORKDIR /home/node/build
RUN npm ci --ignore-scripts --no-audit --no-fund
RUN cp -r /source/src . \
    && cp /source/index.html /source/tsconfig.json /source/vite.config.ts .
COPY driftty-storage.js driftty-storage.test.cjs /compat/
COPY driftty-direct-pty.cjs driftty-direct-pty.test.cjs /compat/
# Проверяем исходный bundle отдельно от производного, до локальной адаптации.
RUN --network=none npm run build \
    && printf '%s  %s\n' "$DRIFTTY_INDEX_SHA256" dist/index.html | sha256sum -c -
# Только проверенная сборка UI, без сети и install/postinstall зависимостей.
RUN --network=none node /compat/driftty-direct-pty.cjs . \
    && node /compat/driftty-direct-pty.test.cjs . \
    && npm test -- --maxWorkers=2 \
    && npm run build \
    && printf '%s  %s\n' "$DRIFTTY_DIRECT_INDEX_SHA256" dist/index.html | sha256sum -c - \
    && node /compat/driftty-storage.test.cjs /compat/driftty-storage.js \
    && node -e 'const fs=require("node:fs"); const path="dist/index.html"; const html=fs.readFileSync(path,"utf8"); if(!html.includes("<head>")) throw Error("Missing HTML head"); fs.writeFileSync(path,html.replace("<head>","<head><!--\n"+fs.readFileSync("/source/LICENSE","utf8")+"\n--><script>"+fs.readFileSync("/compat/driftty-storage.js","utf8")+"</script>"));'

FROM oven/bun:1.3.14-slim@sha256:d56a2534ffd262e92c12fd3249d3924d296d97086da773f821d7d0477435ea04 AS bun
FROM ${PYTHON_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DISABLE_AUTOUPDATER=1 GOTOOLCHAIN=local CGO_ENABLED=0
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl git busybox-static nftables iproute2 tini \
        cmake gcc make libjson-c-dev libwebsockets-dev libwebsockets-evlib-uv libuv1-dev \
    && rm -rf /var/lib/apt/lists/*
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
COPY pins.json /tmp/pins.json
COPY go-download.sh /tmp/go-download.sh
RUN python3 -I -c 'import json; p=json.load(open("/tmp/pins.json")); print(p["GO_VERSION"]); print(p["GO_SHA256"])' > /tmp/go-pins \
    && version="$(sed -n '1p' /tmp/go-pins)" \
    && checksum="$(sed -n '2p' /tmp/go-pins)" \
    && mkdir /tmp/toolchain \
    && bash /tmp/go-download.sh "$version" "$checksum" /tmp/toolchain/go.tar.gz \
    && printf '%s  %s\n' "$checksum" /tmp/toolchain/go.tar.gz | sha256sum -c - \
    && tar -xzf /tmp/toolchain/go.tar.gz -C /usr/local \
    && rm -rf /tmp/toolchain /tmp/go-pins /tmp/pins.json /tmp/go-download.sh
ENV PATH=/usr/local/go/bin:${PATH}
ARG TTYD_VERSION=1.7.7
ARG TTYD_SHA256=039dd995229377caee919898b7bd54484accec3bba49c118e2d5cd6ec51e3650
RUN mkdir -p /tmp/ttyd/source \
    && curl -fsSL -o /tmp/ttyd/source.tar.gz \
        "https://codeload.github.com/tsl0922/ttyd/tar.gz/refs/tags/${TTYD_VERSION}" \
    && printf '%s  %s\n' "$TTYD_SHA256" /tmp/ttyd/source.tar.gz | sha256sum -c - \
    && tar -xzf /tmp/ttyd/source.tar.gz -C /tmp/ttyd/source --strip-components=1 \
    && cmake -S /tmp/ttyd/source -B /tmp/ttyd/build -DCMAKE_BUILD_TYPE=Release \
    && cmake --build /tmp/ttyd/build --parallel 2 \
    && install -m 0755 /tmp/ttyd/build/ttyd /usr/bin/ttyd \
    && rm -rf /tmp/ttyd \
    && ttyd --version
# claude не входит в образ (#155): bootstrap скачивает brood-guest/bro/claude
# с сервера при старте CT (BROOD_ARTIFACTS_DIR).
# Root нужен только supervisor; UID/caps/NoNewPrivs актора задаёт brood-guest.
RUN groupadd --gid 1000 actor \
    && useradd --uid 1000 --gid 1000 --home-dir /workspace/home --no-create-home --shell /bin/bash actor \
    && mkdir -p /workspace /opt/seeds
RUN install -d -m 0700 /etc/brood /var/lib/brood/delivery \
    && printf '%s\n' '/var/lib/brood/delivery' > /etc/brood/delivery-state-dir \
    && chmod 0600 /etc/brood/delivery-state-dir
COPY --from=driftty /home/node/build/dist/index.html /usr/local/share/brood/driftty/index.html
COPY --from=driftty /source/LICENSE /usr/local/share/brood/driftty/LICENSE
COPY brood-guest /usr/local/bin/brood-guest
COPY bro /usr/local/bin/bro
COPY proxmox-guest-dhcp.sh /usr/local/libexec/proxmox-guest-dhcp.sh
COPY seed/ /opt/seeds/
RUN chmod 0755 /usr/local/bin/brood-guest /usr/local/bin/bro /usr/local/libexec/proxmox-guest-dhcp.sh
ARG SOURCE_COMMIT
LABEL org.opencontainers.image.revision=${SOURCE_COMMIT}
WORKDIR /workspace
USER 0:0
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/brood-guest"]
CMD []
