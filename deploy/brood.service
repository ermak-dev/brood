[Unit]
Description=Brood server
Wants=network-online.target
After=network-online.target
ConditionPathExists=/var/lib/brood/releases/current/bin/brood

[Service]
Type=exec
User=brood
Group=brood
StateDirectory=brood
StateDirectoryMode=0700
WorkingDirectory=/var/lib/brood
ExecStart=/usr/local/bin/brood-deploy serve
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
