[Unit]
Description=Brood server
Wants=network-online.target
After=network-online.target
ConditionPathExists=/var/lib/brood/brood

[Service]
Type=exec
User=brood
Group=brood
StateDirectory=brood
StateDirectoryMode=0700
WorkingDirectory=/var/lib/brood
Environment=HOME=/var/lib/brood
ExecStart=/var/lib/brood/brood serve --env-file /var/lib/brood/.env
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
