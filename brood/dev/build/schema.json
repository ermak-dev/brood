{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brood.dev/schemas/broodfile-v1alpha1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "name", "defaultTarget", "sources", "environments", "templates", "networks", "targets"],
  "properties": {
    "apiVersion": {"const": "brood.dev/v1alpha1"},
    "name": {"$ref": "#/$defs/name"},
    "defaultTarget": {"$ref": "#/$defs/name"},
    "pinsFile": {"$ref": "#/$defs/path"},
    "sources": {"$ref": "#/$defs/sources"},
    "environments": {"type": "object", "minProperties": 1, "propertyNames": {"$ref": "#/$defs/name"}, "additionalProperties": {"$ref": "#/$defs/environment"}},
    "templates": {"type": "object", "minProperties": 1, "propertyNames": {"$ref": "#/$defs/name"}, "additionalProperties": {"$ref": "#/$defs/template"}},
    "networks": {"type": "object", "minProperties": 1, "propertyNames": {"$ref": "#/$defs/name"}, "additionalProperties": {"$ref": "#/$defs/network"}},
    "targets": {"type": "object", "minProperties": 1, "propertyNames": {"$ref": "#/$defs/name"}, "additionalProperties": {
      "type": "object", "additionalProperties": false, "required": ["template"], "properties": {"template": {"$ref": "#/$defs/name"}}
    }}
  },
  "$defs": {
    "name": {"type": "string", "maxLength": 63, "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?![\\s\\S])"},
    "path": {"type": "string", "minLength": 1, "maxLength": 1024},
    "pinName": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*(?![\\s\\S])"},
    "strings": {"type": "array", "maxItems": 256, "items": {"type": "string", "maxLength": 16384}},
    "sources": {
      "type": "object", "minProperties": 1, "propertyNames": {"$ref": "#/$defs/name"},
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["type", "destination"],
        "properties": {
          "type": {"enum": ["project", "git"]},
          "destination": {"$ref": "#/$defs/path"},
          "gitMetadata": {"type": "boolean"},
          "repository": {"type": "string", "minLength": 1, "maxLength": 4096},
          "revision": {"type": "string", "pattern": "^[0-9a-f]{40}(?![\\s\\S])"},
          "revisionPin": {"$ref": "#/$defs/pinName"}
        },
        "allOf": [
          {"if": {"properties": {"type": {"const": "git"}}}, "then": {"required": ["repository"], "oneOf": [{"required": ["revision"], "not": {"required": ["revisionPin"]}}, {"required": ["revisionPin"], "not": {"required": ["revision"]}}]}},
          {"if": {"properties": {"type": {"const": "project"}}}, "then": {"not": {"anyOf": [{"required": ["repository"]}, {"required": ["revision"]}, {"required": ["revisionPin"]}]}}}
        ]
      }
    },
    "environment": {
      "type": "object", "additionalProperties": false, "required": ["sources", "build"],
      "properties": {
        "sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/name"}},
        "build": {
          "type": "object", "additionalProperties": false, "required": ["dockerfile", "platform"],
          "properties": {
            "dockerfile": {"$ref": "#/$defs/path"},
            "platform": {"enum": ["linux/amd64", "linux/arm64"]},
            "arguments": {"type": "object", "propertyNames": {"$ref": "#/$defs/pinName"}, "additionalProperties": {"type": "string", "maxLength": 16384}},
            "argsFromPins": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/pinName"}}
          }
        }
      }
    },
    "template": {
      "type": "object", "additionalProperties": false, "required": ["environment", "network", "actor"],
      "properties": {
        "environment": {"$ref": "#/$defs/name"},
        "network": {"$ref": "#/$defs/name"},
        "actor": {"$ref": "#/$defs/actor"}
      }
    },
    "network": {
      "type": "object", "additionalProperties": false,
      "properties": {"tls": {"$ref": "#/$defs/rule"}, "http": {"$ref": "#/$defs/rule"}}
    },
    "rule": {
      "type": "object", "additionalProperties": false, "required": ["hosts", "ports"],
      "properties": {
        "hosts": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "maxLength": 253}},
        "ports": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 65535}}
      }
    },
    "capability": {"enum": ["CHOWN", "DAC_OVERRIDE", "DAC_READ_SEARCH", "FOWNER", "FSETID", "KILL", "SETGID", "SETUID", "SETPCAP", "LINUX_IMMUTABLE", "NET_BIND_SERVICE", "NET_BROADCAST", "NET_ADMIN", "NET_RAW", "IPC_LOCK", "IPC_OWNER", "SYS_MODULE", "SYS_RAWIO", "SYS_CHROOT", "SYS_PTRACE", "SYS_PACCT", "SYS_ADMIN", "SYS_BOOT", "SYS_NICE", "SYS_RESOURCE", "SYS_TIME", "SYS_TTY_CONFIG", "MKNOD", "LEASE", "AUDIT_WRITE", "AUDIT_CONTROL", "SETFCAP", "MAC_OVERRIDE", "MAC_ADMIN", "SYSLOG", "WAKE_ALARM", "BLOCK_SUSPEND", "AUDIT_READ", "PERFMON", "BPF", "CHECKPOINT_RESTORE"]},
    "actor": {
      "type": "object", "additionalProperties": false, "required": ["resources", "containers"],
      "properties": {
        "workerSelector": {
          "type": "object", "additionalProperties": false,
          "properties": {"matchLabels": {"type": "object", "additionalProperties": {"type": "string"}}}
        },
        "resources": {
          "type": "object", "additionalProperties": false, "required": ["limits"],
          "properties": {"limits": {
            "type": "object", "additionalProperties": false, "required": ["cpuMillicores", "memoryBytes"],
            "properties": {
              "cpuMillicores": {"type": "string", "maxLength": 20, "pattern": "^[1-9][0-9]*(?![\\s\\S])"},
              "memoryBytes": {"type": "string", "maxLength": 20, "pattern": "^[1-9][0-9]*(?![\\s\\S])"}
            }
          }}
        },
        "containers": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/container"}},
        "volumes": {"type": "array", "maxItems": 32, "items": {
          "type": "object", "additionalProperties": false, "required": ["name", "durableDir"],
          "properties": {"name": {"$ref": "#/$defs/name"}, "durableDir": {"type": "object", "maxProperties": 0}}
        }},
        "snapshotConfig": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "preferredFidelity": {"const": "SNAPSHOT_FIDELITY_MEMORY"},
            "goldenSnapshotConfig": {"type": "object", "additionalProperties": false, "required": ["mode"], "properties": {"mode": {"const": "GOLDEN_SNAPSHOT_MODE_DISABLED"}}}
          }
        }
      }
    },
    "container": {
      "type": "object", "additionalProperties": false, "required": ["name", "command"],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "command": {"$ref": "#/$defs/strings", "minItems": 1},
        "args": {"$ref": "#/$defs/strings"},
        "env": {"type": "array", "maxItems": 128, "items": {
          "type": "object", "additionalProperties": false, "required": ["name", "value"],
          "properties": {"name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?![\\s\\S])"}, "value": {"type": "string", "maxLength": 16384}}
        }},
        "volumeMounts": {"type": "array", "maxItems": 32, "items": {
          "type": "object", "additionalProperties": false, "required": ["name", "mountPath"],
          "properties": {"name": {"$ref": "#/$defs/name"}, "mountPath": {"type": "string", "pattern": "^/", "maxLength": 1024}}
        }},
        "securityContext": {
          "type": "object", "additionalProperties": false, "required": ["capabilities"],
          "properties": {"capabilities": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "add": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/capability"}},
              "drop": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/capability"}}
            }
          }}
        }
      }
    }
  }
}
