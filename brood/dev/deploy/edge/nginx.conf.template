# Вход brood: TLS, панель на корне, Django и CLIProxyAPI за ним.
#
# Шаблон: при старте entrypoint nginx подставляет переменные окружения
# CLIPROXY_* (NGINX_ENVSUBST_FILTER в манифесте) -- везде, комментарии тоже, так
# что имя ключа в виде подстановки здесь не пишется. Переменные nginx вида
# $host он не трогает: их нет в окружении.

upstream django {
    server django:8000;
}

upstream cliproxy {
    server cliproxy:8317;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

server {
    listen 8080;
    # Проба готовности kubelet: только сам nginx, без Django и прокси -- вход
    # не должен уходить из Service, пока перекатывается сосед.
    location = /edge-healthz {
        access_log off;
        return 200 "ok\n";
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 8443 ssl;
    http2 on;
    ssl_certificate /etc/nginx/tls/tls.crt;
    ssl_certificate_key /etc/nginx/tls/tls.key;
    # Тела LLM-запросов с историей и картинками велики; маленький лимит рвёт
    # и продолжение сессии, и /compact (как в mop, docs/PROXY.md там).
    client_max_body_size 64m;

    # ─── панель ───────────────────────────────────────────────────────────
    # Один файл, маршруты -- после #, так что серверу нужен только корень.
    location = / {
        root /usr/share/nginx/html;
        try_files /index.html =404;
        add_header Cache-Control "no-store";
    }

    # ─── Django ───────────────────────────────────────────────────────────
    location /admin/ {
        include /etc/nginx/brood/django.inc;
    }
    location /static/ {
        include /etc/nginx/brood/django.inc;
    }
    location /auth/ {
        include /etc/nginx/brood/django.inc;
    }
    location = /healthz {
        include /etc/nginx/brood/django.inc;
    }

    # ─── CLIProxyAPI: LLM API ─────────────────────────────────────────────
    # Клиентский ключ проверяет сам прокси (access.api-keys).
    location /v1/ {
        include /etc/nginx/brood/cliproxy.inc;
    }
    location /v1beta/ {
        include /etc/nginx/brood/cliproxy.inc;
    }
    location /openai/v1/ {
        include /etc/nginx/brood/cliproxy.inc;
    }
    location /backend-api/codex/ {
        include /etc/nginx/brood/cliproxy.inc;
    }
    # Возвраты OAuth провайдеров на основной порт прокси.
    location ~ ^/(anthropic|codex|antigravity|devin)/callback$ {
        include /etc/nginx/brood/cliproxy.inc;
    }
    location = /callback {
        include /etc/nginx/brood/cliproxy.inc;
    }

    # ─── CLIProxyAPI: management ──────────────────────────────────────────
    # Только с сессией brood (Django решает, auth_request); ключ ставит вход,
    # клиентский Authorization и X-Management-Key затираются.
    location /v8/management/ {
        auth_request /_brood/llm;
        proxy_set_header Authorization "Bearer ${CLIPROXY_MANAGEMENT_KEY}";
        proxy_set_header X-Management-Key "";
        include /etc/nginx/brood/cliproxy.inc;
    }
    location = /_brood/llm {
        internal;
        proxy_pass http://django/auth/llm;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Original-Method $request_method;
        proxy_set_header X-Original-URI $request_uri;
    }

    # Прочее -- не наше: корень и встроенная панель прокси, legacy
    # /v0/management.
    location / {
        return 404;
    }
}
