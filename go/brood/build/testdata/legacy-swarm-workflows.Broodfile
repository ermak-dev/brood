apiVersion: brood.dev/v1alpha1
defaultTarget: development
environments:
    python:
        build:
            dockerfile: project/environment/Dockerfile
            platform: linux/amd64
        sources:
            - project
name: legacy-swarm-workflows
networks:
    offline: {}
sources:
    project:
        destination: project
        type: project
targets:
    development:
        template: python
templates:
    python:
        actor:
            containers:
                - args:
                    - --version
                  command:
                    - python3
                  name: main
            resources:
                limits:
                    cpuMillicores: "1000"
                    memoryBytes: "1073741824"
        environment: python
        network: offline
workflows:
    swarm-architecture:
        edges:
            - condition: outcome=success
              from: triage
              to: architecture
            - condition: outcome=success
              from: architecture
              to: decision
            - condition: outcome=success
              from: decision
              to: implement
            - condition: outcome=fail
              from: decision
              to: done
            - condition: outcome=success
              from: implement
              to: review
            - condition: outcome=success
              from: review
              to: test
            - condition: outcome=success
              from: test
              to: integrate
            - condition: outcome=success
              from: integrate
              to: done
        exit: done
        goalGates:
            - done
        nodes:
            architecture:
                prompt: 'Prepare the architectural decision for a human: describe the problem, alternatives, tradeoffs, risks, recommendation and open questions. Do not implement or treat the proposal as approved.'
                role: review
                type: actor
            decision:
                options:
                    - label: Approve
                      outcome: success
                    - label: Reject
                      outcome: fail
                question: Approve the proposed architectural decision for implementation?
                type: human
            done:
                type: exit
            implement:
                prompt: Implement only the approved architecture and scoped issue, following CLAUDE.md, the issue and branch process, layer boundaries and required test-first development. Report evidence and blockers; stop if the approval or requirements cannot be established.
                role: build
                type: actor
            integrate:
                prompt: 'Follow the CLAUDE.md landing process for the approved change: review the diff, rebase on main and use one push, with review comments handled in a separate push without rebase. Confirm required checks and permissions; report blockers and never claim integration without evidence. Do not deploy or perform an action without the required authorization.'
                role: build
                type: actor
            review:
                prompt: Independently review the implementation in a fresh session, without relying on the implementer's conclusions. Examine the diff against the approved architecture and CLAUDE.md. Report findings and block progress if unresolved or independence cannot be established.
                role: review
                type: actor
            test:
                prompt: Run the applicable checks from CLAUDE.md, including brood dev test and ruff check, and Go build and tests for Go changes. For panel changes run the prescribed web tests and browser checks. Report exact results and fail on errors, unavailable checks, or unresolved review findings.
                role: build
                type: actor
            triage:
                prompt: Investigate the issue, check for duplicates and document evidence, scope, and why an architectural decision is needed. Follow CLAUDE.md; stop and report blockers rather than claiming success.
                role: review
                type: actor
        start: triage
    swarm-development:
        edges:
            - condition: outcome=success
              from: triage
              to: implement
            - condition: outcome=success
              from: implement
              to: review
            - condition: outcome=success
              from: review
              to: test
            - condition: outcome=success
              from: test
              to: integrate
            - condition: outcome=success
              from: integrate
              to: done
        exit: done
        goalGates:
            - done
        nodes:
            done:
                type: exit
            implement:
                prompt: Implement the scoped issue following CLAUDE.md, including the issue and branch process, one change per layer, and test-first development where required. Report the diff, evidence, and blockers; do not claim success on failure or substitute instructions for authorization.
                role: build
                type: actor
            integrate:
                prompt: 'Follow the CLAUDE.md landing process for the approved change: review the diff, rebase on main and use one push, with review comments handled in a separate push without rebase. Confirm required checks and permissions; report blockers and never claim integration without evidence. Do not deploy or perform an action without the required authorization.'
                role: build
                type: actor
            review:
                prompt: Independently review the implementation in a fresh session, without relying on the implementer's conclusions. Examine the diff for defects, regressions, and project rule violations. Report findings and block progress if unresolved or independence cannot be established.
                role: review
                type: actor
            test:
                prompt: Run the applicable checks from CLAUDE.md, including brood dev test and ruff check, and Go build and tests for Go changes. For panel changes run the prescribed web tests and browser checks. Report exact results and fail on errors, unavailable checks, or unresolved review findings.
                role: build
                type: actor
            triage:
                prompt: Investigate the issue and existing code. Check for duplicates, establish evidence and scope, and report the plan and unknowns. Follow CLAUDE.md. If an architectural decision is needed, stop and report that the architecture workflow must be selected externally. Do not claim success if blocked or unable to establish the requirements.
                role: review
                type: actor
        start: triage
